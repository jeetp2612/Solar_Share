# ── SolarShare local configuration ─────────────────────────────────────────
# 1. Copy this file:            cp .env.local.example .env.local
# 2. Paste your Neon string:    DATABASE_URL=postgres://user:pass@host/db
# 3. Restart the dev server:    npm run dev
#
# Full walkthrough: docs/LOCAL-SETUP.md (includes how to get the Neon string)
#
# ⚠️  .env.local is in .gitignore — it holds your database password.
#     NEVER commit or share it.
#
# Leave the line below empty and the app runs on the built-in in-memory
# database (PGLite) — great for a quick look, but data resets on every
# restart. Set it to use the proper persistent database.
# Example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

DATABASE_URL=

# ── Optional: pin the public-chain bridge to ONE RPC endpoint ───────────────
# The ledger's "Live network" panel reads Polygon's Amoy testnet (chainId
# 80002) through keyless public RPCs. It sticks to whichever provider answers
# so the URL stops rotating; set this to pin one permanently (e.g. your own
# Alchemy / Infura / QuickNode Amoy URL). Endpoints that answer with a
# different chainId are rejected, never displayed.
# Example:
# SOLARSHARE_RPC_URL="https://polygon-amoy.g.alchemy.com/v2/YOUR_KEY"

SOLARSHARE_RPC_URL=
